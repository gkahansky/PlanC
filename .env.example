# Copy this file to .env and fill in your actual keys/values.
# .env is gitignored — never commit real keys.

# ── Asset Universe ───────────────────────────────────────────
# true  → track only the tickers defined in PREDEFINED_ASSETS (config.py)
# false → use a dynamically-built universe (future feature)
USE_PREDEFINED_ASSETS=true

# ── Scheduling (minutes) ─────────────────────────────────────
FETCH_INTERVAL_TECHNICAL=15
FETCH_INTERVAL_FUNDAMENTAL=1440
FETCH_INTERVAL_INSTITUTIONAL=10080
FETCH_INTERVAL_SENTIMENT=30

# ── Volatility Thresholds ────────────────────────────────────
# RSI levels and minimum composite signal score per category.
# Slow stocks use tighter bands; high-volatility stocks use wider ones.
RSI_OVERSOLD_SLOW=35
RSI_OVERBOUGHT_SLOW=65
MIN_SIGNAL_SLOW=0.60

RSI_OVERSOLD_MEDIUM=30
RSI_OVERBOUGHT_MEDIUM=70
MIN_SIGNAL_MEDIUM=0.55

RSI_OVERSOLD_HIGH=25
RSI_OVERBOUGHT_HIGH=75
MIN_SIGNAL_HIGH=0.50

# ── Stop-Loss Thresholds ─────────────────────────────────────
# Max loss from entry before position is force-closed.
STOP_LOSS_SLOW=0.05
STOP_LOSS_MEDIUM=0.08
STOP_LOSS_HIGH=0.12

# ── Signal Component Weights ─────────────────────────────────
# Set WEIGHT_FUNDAMENTAL > 0 once FMP_API_KEY is configured and
# fundamentals have been fetched. Weights are auto-normalised.
WEIGHT_TECHNICAL=1.0
WEIGHT_FUNDAMENTAL=0.0

# ── API Keys ─────────────────────────────────────────────────
# ── Alpha Vantage ────────────────────────────────────────────
# Free tier: 25 requests/day, 500/month
# Sign up: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here

# ── Financial Modeling Prep ──────────────────────────────────
# Free tier: 250 requests/day
# Sign up: https://financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_key_here

# ── Finnhub ──────────────────────────────────────────────────
# Free tier: 60 requests/minute
# Sign up: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key_here

# ── Twelve Data ──────────────────────────────────────────────
# Free tier: 8 requests/minute, 800/day
# Sign up: https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=your_twelvedata_key_here

# ── Polygon.io ───────────────────────────────────────────────
# Free tier: unlimited calls but previous-day data only (no real-time)
# Sign up: https://polygon.io/dashboard/signup
POLYGON_API_KEY=your_polygon_key_here

# ── Email Alerts (optional) ──────────────────────────────────
# Leave blank to disable email; console alerts are always on.
# Works with any SMTP server (Gmail, SendGrid, etc.)
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your_app_password   ← generate at myaccount.google.com/apppasswords
#   ALERT_EMAIL_TO=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
